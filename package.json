{
  "name": "auvism",
  "version": "1.0.0",
  "description": "Audio Visualisation for MacOS/OS X",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "audio",
    "visualizer",
    "macos",
    "electron"
  ],
  "author": "AdalricP",
  "license": "MIT",
  "devDependencies": {
    "auto-launch": "^5.0.5",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "auto-launch": "^5.0.5"
  },
  "build": {
    "appId": "com.adalricp.auvism",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!**/*.map"
    ],
    "asar": true,
    "extraResources": []
  }
}